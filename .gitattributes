# Texto usa LF por padrão. Esta regra não reescreve arquivos existentes.
* text=auto eol=lf

# Scripts nativos do Windows preservam CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binários não participam de normalização ou diff textual.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.docx binary
*.xlsx binary
*.dwg binary
